{
    "name": "bekambeyene/telebirr",
    "description": "A Laravel and PHP SDK for Telebirr H5/SuperApp integration with webhook verification, RSA signing, and production-ready interoperability support.",
    "keywords": [
        "telebirr",
        "laravel",
        "php",
        "payment-gateway",
        "ethiopia",
        "h5-payment",
        "superapp",
        "webhook",
        "rsa",
        "sdk"
    ],
    "homepage": "https://github.com/bekambeyene/telebirr",
    "support": {
        "issues": "https://github.com/bekambeyene/telebirr/issues",
        "source": "https://github.com/bekambeyene/telebirr"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bekam Beyene",
            "email": "bbekam60@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "phpseclib/phpseclib": "^3.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "*",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Bekambeyene\\Telebirr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bekambeyene\\Telebirr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bekambeyene\\Telebirr\\Providers\\TelebirrServiceProvider"
            ],
            "aliases": {
                "Telebirr": "Bekambeyene\\Telebirr\\Facades\\Telebirr"
            }
        }
    }
}
