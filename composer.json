{
    "name": "bekambeyene/telebirr",
    "description": "Telebirr payment gateway integration for PHP and Laravel 10, 11, 12, and 13.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bekam Beyene",
            "email": "bbekam60@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "phpseclib/phpseclib": "^3.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "phpstan/phpstan": "^1.10",
        "nunomaduro/larastan": "^2.9 || ^3.0",
        "laravel/pint": "^1.14"
    },
    "autoload": {
        "psr-4": {
            "Bekambeyene\\Telebirr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bekambeyene\\Telebirr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bekambeyene\\Telebirr\\Providers\\TelebirrServiceProvider"
            ],
            "aliases": {
                "Telebirr": "Bekambeyene\\Telebirr\\Facades\\Telebirr"
            }
        }
    }
}
